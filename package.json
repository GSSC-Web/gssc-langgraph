{
  "name": "gssc-langgraph",
  "version": "0.1.0",
  "description": "Standalone LangGraph.js service for GSSC-Web (consumed by gssc5).",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bunx @langchain/langgraph-cli dev",
    "build": "bunx tsc -p tsconfig.json",
    "test": "bun test",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit",
    "lint": "bunx tsc -p tsconfig.json --noEmit",
    "review": "bun run src/review/cli.ts",
    "closeout": "bun run src/closeout/cli.ts",
    "test-dev": "bun run src/test_dev/cli.ts",
    "software": "bun run src/software/cli.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.3.2",
    "@langchain/langgraph": "^1.5.3",
    "@langchain/xai": "^1.5.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@langchain/langgraph-cli": "^1.1.2",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.3"
  }
}
