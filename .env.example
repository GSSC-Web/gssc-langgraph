# Copy to .env for local development: cp .env.example .env
#
# LangSmith tracing (optional for local `bun run dev` / langgraph-cli,
# required for Studio / hosted workflows that push traces).
# Set LANGSMITH_TRACING=true to send runs to LangSmith when a key is present.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=gssc-langgraph

# LLM provider — xAI (Grok) is the default for domain graphs via createChatModel().
# Smoke assistant (health) stays model-free.
# Get a key at https://console.x.ai/
XAI_API_KEY=
# Optional model override (default: grok-4.7). Prefer GSSC_XAI_MODEL.
# GSSC_XAI_MODEL=grok-4.7
# XAI_MODEL=grok-4.7

# Other providers — not used by default; keep commented unless a graph opts in.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Assumed local service URL for gssc5 (server-side) clients.
# Default `@langchain/langgraph-cli dev` listens on http://127.0.0.1:2024
GSSC_LANGGRAPH_BASE_URL=http://127.0.0.1:2024

# Checkpointer: conversation (and other compileWithMemory graphs) use
# in-process MemorySaver — no env required. State is keyed by Agent Server /
# SDK thread_id and is lost on process restart. Durable Postgres/SQLite savers
# are a later production follow-up (no config here yet).

# gssc5 Dot Agents context (software_dev / test_development).
# GSSC5_ROOT = filesystem path to an existing checkout (NOT a git URL).
# GSSC5_ROOT=/absolute/path/to/gssc5
# If unset and no sibling ../gssc5, the service shallow-clones/fetches into cache:
# GSSC5_CACHE_DIR=~/.cache/gssc-langgraph/gssc5-repo
# GSSC5_REPO_URL=https://github.com/GSSC-Web/gssc5.git
# GSSC5_REF=master
# GSSC5_AUTO_CHECKOUT=true
